{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-voice-tts",
  "version": "1.0.0-beta.1",
  "description": "Synthèse vocale locale : Kokoro (54 voix, immédiat) et Qwen3-TTS. La langue se devine du texte, la voix suit. Rien ne quitte la machine.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-voice-tts",
  "repository": "https://github.com/Locaryn/morph-voice-tts",
  "keywords": [
    "voice-tts",
    "text-to-speech",
    "voice-cloning",
    "kokoro",
    "qwen3-tts",
    "piper"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le moteur de synthèse vocale local."
    },
    "files.read": {
      "reason": "Lire les modèles de voix et fichiers audio de référence."
    },
    "files.write": {
      "reason": "Sauvegarder les fichiers audio générés et profils de voix."
    },
    "network": {
      "reason": "Télécharger les modèles vocaux depuis HuggingFace."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "voice-tts",
    "voice-cloning"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "voice-tts-catalog",
        "slot": "marketplace.catalogs",
        "order": 14,
        "type": "data",
        "label": "Modèles de synthèse vocale",
        "icon": "mic",
        "entry": "dist/marketplace.json",
        "hint": "Ajoute les modèles vocaux Kokoro et Piper au catalogue"
      },
      {
        "id": "voice-tts-studio",
        "slot": "studio.tabs",
        "order": 14,
        "label": "Synthèse vocale",
        "icon": "mic",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-voice-tts-panel",
        "hint": "Lecture audio et clonage de voix"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "1.0.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (Pre-release) — non testée par des utilisateurs",
      "tag": "v1.0.0-beta.1",
      "released_at": "2026-08-28"
    },
    {
      "version": "0.9.0",
      "is_beta": false,
      "summary": "Version de référence stable",
      "tag": "v0.9.0",
      "released_at": "2026-08-20"
    },
    {
      "version": "0.8.5",
      "is_beta": false,
      "summary": "Version précédente stable",
      "tag": "v0.8.5",
      "released_at": "2026-08-15"
    },
    {
      "version": "0.8.0",
      "is_beta": false,
      "summary": "Version initiale du socle",
      "tag": "v0.8.0",
      "released_at": "2026-08-01"
    }
  ]
}
